# Exemplo de variáveis de ambiente. Spring Boot não carrega este arquivo automaticamente.
# Defina-as no terminal, na configuração de execução ou no serviço de hospedagem.
SPRING_PROFILES_ACTIVE=postgres
SERVER_PORT=8080
APP_TIME_ZONE=America/Sao_Paulo
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Copie a conexão JDBC do seu projeto PostgreSQL. Utilize SSL no serviço hospedado.
# Use conexão direta ou pooler em modo session (porta 5432), não transaction pooler.
DB_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
